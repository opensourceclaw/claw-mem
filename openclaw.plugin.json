{
  "id": "claw-mem",
  "version": "7.4.0",
  "kind": "memory",
  "name": "Claw Memory System",
  "description": "Persistent memory storage and retrieval for AI agents",
  "author": "OpenClaw Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/opensourceclaw/claw-mem"
  },
  "capabilities": [
    "memory-store",
    "memory-retrieve",
    "memory-search",
    "memory-manage"
  ],
  "entry": "./openclaw_plugin/index.ts",
  "exports": {
    ".": "./openclaw_plugin/index.ts",
    "./plugin": "./src/plugin.ts",
    "./types": "./src/types.ts"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "storagePath": {
        "type": "string",
        "default": "~/.openclaw/memory",
        "description": "Memory storage directory path"
      },
      "maxFileSize": {
        "type": "string",
        "default": "10MB",
        "description": "Maximum memory file size"
      },
      "compression": {
        "type": "boolean",
        "default": true,
        "description": "Enable memory compression"
      }
    }
  },
  "contracts": {
    "tools": [
      "memory_search",
      "memory_store",
      "memory_get",
      "memory_forget",
      "memory_failure_classify",
      "memory_get_constitution",
      "memory_promote_constitution_rule",
      "memory_delete_constitution_rule",
      "memory_transcript_get",
      "memory_transcript_search",
      "memory_session_snapshot",
      "memory_session_get_latest",
      "memory_entity_search",
      "memory_entity_list",
      "memory_get_preference",
      "memory_rollback_preference"
    ]
  }
}

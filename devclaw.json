{
  "name": "claw-mem",
  "version": "6.12.0",
  "sdlc": {
    "enabled": true,
    "stages": [
      {
        "name": "Plan",
        "trigger": "manual",
        "agentType": "devclaw",
        "tools": ["health-check", "benchmark"],
        "gates": ["L1", "L2"]
      },
      {
        "name": "Code",
        "trigger": "event",
        "agentType": "jarvis",
        "tools": ["code-gen", "lint"],
        "gates": ["L1", "L2", "L3"]
      },
      {
        "name": "Test",
        "trigger": "event",
        "agentType": "devclaw",
        "tools": ["vitest", "coverage"],
        "gates": ["L1", "L3"]
      },
      {
        "name": "Review",
        "trigger": "manual",
        "agentType": "devclaw",
        "tools": ["github-pr", "code-review"],
        "gates": ["L2", "L3"]
      },
      {
        "name": "Deploy",
        "trigger": "manual",
        "agentType": "devclaw",
        "tools": ["npm-publish", "github-release"],
        "gates": ["L1", "L2", "L3", "L4"]
      },
      {
        "name": "Operate",
        "trigger": "scheduled",
        "agentType": "ops-agent",
        "tools": ["health-monitor", "metrics"],
        "gates": ["L5", "L6"]
      },
      {
        "name": "Govern",
        "trigger": "scheduled",
        "agentType": "devclaw",
        "tools": ["audit", "compliance"],
        "gates": ["L1", "L2", "L3", "L4", "L5", "L6"]
      }
    ]
  },
  "integrations": {
    "github": {
      "owner": "opensourceclaw",
      "repo": "claw-mem"
    },
    "openclaw": {
      "plugins": ["memory", "context-engine"]
    }
  }
}

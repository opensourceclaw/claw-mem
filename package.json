{
  "name": "claw-mem",
  "version": "6.25.0",
  "description": "Local-First Three-Tier Memory System for OpenClaw (TypeScript)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "openclaw": {
    "extensions": [
      "./dist/plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.28",
      "minGatewayVersion": "2026.3.28"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "vitest run tests/benchmarks --reporter=json > benchmark-results.json 2>&1 || true"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "openai": "^6.42.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "typescript": "^5.0.0",
    "vitest": "^4.1.6"
  },
  "keywords": [
    "memory",
    "ai",
    "llm",
    "openclaw"
  ],
  "author": "Peter Cheng",
  "license": "Apache-2.0"
}

{
  "name": "@opensourceclaw/claw-mem",
  "version": "7.9.0",
  "description": "Local-First Three-Tier Memory System for OpenClaw (TypeScript)",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js",
    "./plugin": "./dist/src/plugin.js",
    "./pi": "./pi_plugin/index.ts"
  },
  "openclaw": {
    "extensions": [
      "./dist/src/plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.28",
      "minGatewayVersion": "2026.3.28"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "node dist/benchmarks/runner.js"
  },
  "dependencies": {
    "@opensourceclaw/claw-ctx": "^6.6.1",
    "claw-gov": "npm:@opensourceclaw/claw-gov@^7.5.0",
    "js-yaml": "^4.3.2",
    "openai": "^6.42.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@sinclair/typebox": "^0.34.52",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "openclaw": "^2026.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "memory",
    "ai",
    "llm",
    "openclaw"
  ],
  "author": "Peter Cheng",
  "license": "Apache-2.0",
  "overrides": {
    "vite": "^8.3.6",
    "@modelcontextprotocol/sdk": ">=1.32.0",
    "@hono/node-server": "2.1.3",
    "body-parser": "2.4.0",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.9",
    "hono": "4.13.17",
    "ip-address": "10.7.6",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "source-map-js": "1.2.2",
    "undici": "8.12.2",
    "zod": "4.6.7",
    "openclaw": {
      "minimatch": "11.0.1"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "openclaw": ">=2026.3.28"
  }
}

{
  "name": "claw-mem",
  "version": "7.3.0",
  "description": "Local-First Three-Tier Memory System for OpenClaw (TypeScript)",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "openclaw": {
    "extensions": [
      "./dist/src/plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.28",
      "minGatewayVersion": "2026.3.28"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "node dist/benchmarks/runner.js"
  },
  "dependencies": {
    "@opensourceclaw/claw-ctx": "file:../claw-ctx",
    "claw-gov": "file:../claw-gov",
    "js-yaml": "^4.3.1",
    "openai": "^6.42.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "memory",
    "ai",
    "llm",
    "openclaw"
  ],
  "author": "Peter Cheng",
  "license": "Apache-2.0",
  "overrides": {
    "vite": "^8.2.1"
  }
}

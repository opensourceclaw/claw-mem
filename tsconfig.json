{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "NodeNext",
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "benchmarks/**/*.ts", "pi_plugin/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}

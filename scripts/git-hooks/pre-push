#!/bin/sh
# Repo pre-push gates for claw-mem (invoked by ~/.git-hooks/pre-push after
# gate.mjs; stdin carries the complete refs list).
#
# 1) push-dispatch (Peter ruling 2026-11-06): pushing to a remote is a release
#    action executed by Karen — Friday only commits. Every main push needs an
#    inbox/inbox-release/ record with 'Approver: Peter' + 'APPROVED' +
#    'Dispatcher: Karen' (To: Karen / Assignee: Karen accepted) inside the
#    batch window. The same file may carry the Peter approval — never force two
#    files. Checked BEFORE visibility: PRIVATE / unknown-visibility repos are
#    bound as well; only a non-git directory is skipped.
# 2) publish-scope hygiene (rule 2026-11-06, Peter):
#    PUBLIC repo: inbox/ 与 docs/ 不纳入版本管控,不得提交/推送到 GitHub。
#    PRIVATE repo: inbox/ 与 docs/ 纳入版本管控,可推送。
#    Non-GitHub / unknown visibility: skip (fail-open) — 归属不明不由本钩子拦。
set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

is_zero_sha() {
  case "$1" in
    *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

mtime_of() {
  m=$(stat -c %Y "$1" 2>/dev/null) || m=$(stat -f %m "$1" 2>/dev/null) || m=0
  case "$m" in ''|*[!0-9]*) m=0 ;; esac
  echo "$m"
}

# --- 1) push-dispatch gate (all main pushes, visibility-independent) --------
dispatch_rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$remote_sha" ] && continue
  is_zero_sha "$local_sha" && continue

  wstart=0
  if is_zero_sha "$remote_sha"; then
    wstart=$(git log --reverse --format=%ct "$local_sha" 2>/dev/null | head -1)
  else
    wstart=$(git log --format=%ct "$remote_sha..$local_sha" 2>/dev/null | tail -1)
  fi
  case "$wstart" in ''|*[!0-9]*) wstart=0 ;; esac

  dispatch_ok=0
  for f in "$ROOT/inbox/inbox-release"/*.md; do
    [ -e "$f" ] || continue
    if grep -qE 'Approver.*Peter' "$f" 2>/dev/null \
      && grep -q 'APPROVED' "$f" 2>/dev/null \
      && grep -qE '(Dispatcher|To|Assignee)[^:]*:.*Karen' "$f" 2>/dev/null; then
      if [ "$(mtime_of "$f")" -ge "$wstart" ]; then
        dispatch_ok=1
        break
      fi
    fi
  done

  if [ "$dispatch_ok" -ne 1 ]; then
    echo "[push-dispatch] PUSH REJECTED: push to refs/heads/main is a release action owned by Karen (Peter ruling 2026-11-06)." >&2
    echo "  - missing: inbox/inbox-release/ record with 'Approver: Peter' + 'APPROVED' + 'Dispatcher: Karen' (or To: Karen / Assignee: Karen) newer than batch start" >&2
    echo "  - fix: add the dispatch record (the same file may carry the Peter approval) and retry" >&2
    dispatch_rc=1
  fi
done
[ "$dispatch_rc" -eq 0 ] || exit 1

# --- 2) publish-scope hygiene ----------------------------------------------
VIS=$(gh repo view --json visibility -q .visibility 2>/dev/null) || VIS=""

case "$VIS" in
  PUBLIC) ;;
  *) exit 0 ;;   # PRIVATE / 空(非 GitHub 仓): 本规则不适用
esac

TRACKED=$(git ls-files -- 'inbox/*' 'docs/*' 'inbox/**/*' 'docs/**/*' 2>/dev/null | sort -u)
if [ -n "$TRACKED" ]; then
  echo "[publish-scope] PUSH REJECTED: PUBLIC repo 不得跟踪 inbox/ 或 docs/（Peter 规则 2026-11-06）。先 untrack:" >&2
  echo "$TRACKED" | head -20 >&2
  echo "  fix: git rm -r --cached inbox docs && git commit -m 'chore: untrack inbox/docs (public repo)'" >&2
  exit 1
fi

# 已跟踪为空后,再确认 gitignore 有兜底,防止新增文件再次混入
for d in inbox docs; do
  if [ -d "$ROOT/$d" ] && ! git check-ignore -q "$ROOT/$d" 2>/dev/null; then
    echo "[publish-scope] PUSH REJECTED: PUBLIC repo 的 $d/ 未被 .gitignore 覆盖，可能混入后续提交。" >&2
    exit 1
  fi
done

exit 0
